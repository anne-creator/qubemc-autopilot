---
import PixelPreview from "@/components/explore/PixelPreview.astro";
import IncidentIcon from "@/components/explore/IncidentIcon.astro";
import "@/styles/autopilot-motion.css";

const stages = [
  [
    "Vault is missing.",
    "Paper stops during startup. The plugin error names the dependency it needs.",
    "Startup log",
    "Plugin load failure: required dependency Vault was not found.",
    "Escalate if the logs don’t establish a cause.",
  ],
  [
    "Install a compatible version of Vault.",
    "A mismatched build could keep the plugin from loading.",
    "Before installation",
    "Check the Vault version against the server build and verify the download source.",
    "Only plugins from trusted sources are eligible.",
  ],
  [
    "Approve the install for this server.",
    "The gateway checks permissions and action parameters. An authorized operator reviews the plan.",
    "Before approval",
    "Confirm the target server, trusted source, and recent backup.",
    "Execution requires both policy checks and operator approval.",
  ],
  [
    "Check the next boot.",
    "Review the startup log. Confirm that Paper starts and the plugin loads with Vault.",
    "If the server still fails",
    "Roll back the change or escalate to an operator.",
    "Record the outcome and recovery decision in the audit log.",
  ],
];

const incidents = [
  [
    "plugin",
    "Plugin conflicts",
    "Missing dependencies, incompatible versions, and failed updates.",
  ],
  [
    "runtime",
    "Runtime mismatches",
    "Incompatible Java versions and server builds.",
  ],
  [
    "memory",
    "Memory failures",
    "Out-of-memory errors and recurring crash loops.",
  ],
  [
    "storage",
    "Storage & configuration",
    "Full disks, failed writes, and invalid configuration.",
  ],
  [
    "performance",
    "Performance issues",
    "Low ticks per second (TPS) and slow server ticks.",
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta name="robots" content="noindex,nofollow" />
    <title>QubeMC Autopilot · AI operations for game hosting teams</title>
    <meta
      name="description"
      content="QubeMC is building Autopilot for game hosting teams. It proposes repairs and applies them only after operator approval."
    />
    <link rel="icon" href="/assets/img/optimized/logo-mark-128.webp" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href="/assets/fonts/Doto-BoldSquare.woff2"
    />
  </head>
  <body>
    <div class="terrain-backdrop hero-backdrop" aria-hidden="true">
      <img src="/assets/img/optimized/background_home.webp" alt="" />
    </div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="#"
        ><img
          src="/assets/img/optimized/logo-mark-128.webp"
          width="32"
          height="32"
          alt=""
        />QubeMC <span class="brand-product">Autopilot</span></a
      >
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#workflow">Workflow</a><a href="#safety">Safety</a><a
          href="#incidents">Incidents</a
        ><a href="#environment">Environment</a>
      </nav>
      <a class="button small desktop-contact" href="#contact">Let’s talk</a>
      <button
        class="menu-button"
        aria-expanded="false"
        aria-controls="mobile-nav">Menu</button
      >
      <nav id="mobile-nav" hidden aria-label="Mobile navigation">
        <a href="#workflow">Workflow</a><a href="#safety">Safety</a><a
          href="#incidents">Incidents</a
        ><a href="#environment">Environment</a><a
          class="menu-action"
          href="#contact">Let’s talk</a
        ><a class="menu-action" href="https://www.qubemc.com/">QubeMC website</a
        >
      </nav>
    </header>
    <main id="main">
      <section class="hero-stage" data-screen>
        <div class="hero-backdrop" aria-hidden="true">
          <img
            src="/assets/img/optimized/background_home.webp"
            alt=""
            fetchpriority="high"
          />
        </div>
        <div class="hero wrap">
          <div class="hero-copy">
            <h1 id="hero-title">
              <span class="title-line">AI operations for</span>
              <span class="title-line">game hosting teams.</span>
            </h1>
            <p class="intro">
              Autopilot finds the cause and proposes a fix. It applies the fix
              only after you approve it.
            </p>
            <p class="hero-audience">
              For game hosts, server networks, and on-call teams.
            </p>
            <div class="actions">
              <a class="button primary" href="#workflow">See the repair steps</a
              ><a class="button secondary" href="#contact">Talk to the team</a>
            </div>
          </div>
          <article class="product" aria-labelledby="example-incident-title">
            <div class="product-top">
              <h2 id="example-incident-title">
                <span>Startup failed.</span>
                <span>Vault is missing.</span>
              </h2>
              <div class="incident-heading">
                <span class="demo-label">Plugin dependency example</span>
                <span class="status">Needs review</span>
              </div>
            </div>
            <PixelPreview />
            <div class="incident-body">
              <div class="console">
                <span class="console-label">Startup log</span><code
                  >Plugin failed to load<br /><span
                    >Missing required dependency: Vault</span
                  ></code
                >
              </div>
              <div class="repair">
                <strong>Install a compatible Vault build</strong>
                <p>Verify the source and take a backup first.</p>
              </div>
            </div>
          </article>
        </div>
      </section>
      <section id="workflow" data-screen>
        <div class="section wrap">
          <div class="section-heading">
            <div>
              <h2>
                Getting the server<br />back online
              </h2>
            </div><p>
              Follow the proposed Vault repair from the first startup error to
              the next boot.
            </p>
          </div>
          <div class="workflow-layout">
            <div class="steps" role="tablist" aria-label="Incident workflow">
              <button
                role="tab"
                id="step-0"
                aria-selected="true"
                aria-controls="workflow-panel"
                data-step="0"
                ><span>01</span><strong>Read the log</strong></button
              >
              <button
                role="tab"
                id="step-1"
                aria-selected="false"
                aria-controls="workflow-panel"
                tabindex="-1"
                data-step="1"
                ><span>02</span><strong>Review the fix</strong></button
              >
              <button
                role="tab"
                id="step-2"
                aria-selected="false"
                aria-controls="workflow-panel"
                tabindex="-1"
                data-step="2"
                ><span>03</span><strong>Approve the change</strong></button
              >
              <button
                role="tab"
                id="step-3"
                aria-selected="false"
                aria-controls="workflow-panel"
                tabindex="-1"
                data-step="3"
                ><span>04</span><strong>Verify recovery</strong></button
              >
            </div>
            <div
              class="workflow-panel"
              role="tabpanel"
              id="workflow-panel"
              aria-labelledby="step-0"
              tabindex="0"
            >
              <div class="panel-bar">
                <span class="mono">Paper startup failure</span>
                <button class="button rotation-control" type="button" hidden
                  >Pause autoplay</button
                >
              </div>
              <div class="panel-content">
                <div class="workflow-signal" aria-hidden="true">
                  <div class="signal-nodes">
                    {
                      [0, 1, 2, 3].map((step) => (
                        <span
                          class="signal-node"
                          data-current={step === 0 ? "" : undefined}
                        />
                      ))
                    }
                  </div>
                  <div class="signal-travel"><span></span></div>
                </div>
                <div class="workflow-cards">
                  {
                    stages.map(
                      (
                        [title, description, evidenceLabel, evidence, note],
                        index,
                      ) => (
                        <div
                          class="workflow-card"
                          data-active={index === 0 ? "" : undefined}
                          aria-hidden={index !== 0}
                        >
                          <h3>{title}</h3>
                          <p class="workflow-description">{description}</p>
                          <div class="evidence-block">
                            <span class="mono muted">{evidenceLabel}</span>
                            <p>{evidence}</p>
                          </div>
                          <div class="panel-note">
                            <span class="square" />
                            {note}
                          </div>
                        </div>
                      ),
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section id="safety" class="safety-section" data-screen>
        <div class="wrap safety-layout">
          <div class="safety-copy">
            <h2>
              Who can change<br />a server?
            </h2><p>
              In our design, the agent can propose a repair. Your access policy
              sets its limits, and an operator approves risky changes.
            </p><div class="boundary">
              <span class="square"></span> No unrestricted shell access
            </div>
          </div><div class="safety-list">
            <article>
              <div>
                <h3>Scoped access</h3><p>
                  Each credential limits access to a specific tenant, server,
                  and task.
                </p>
              </div>
            </article><article>
              <div>
                <h3>Allowed actions</h3><p>
                  The gateway checks each action’s parameters and approval
                  rules.
                </p>
              </div>
            </article><article>
              <div>
                <h3>Backups and rollback</h3><p>
                  Back up before a risky change. Check server health afterward
                  and roll back if needed.
                </p>
              </div>
            </article><article>
              <div>
                <h3>Audit log</h3><p>
                  Each entry links the evidence, requested change, approver, and
                  result.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section id="incidents" data-screen>
        <div class="section wrap incidents">
          <div class="section-heading">
            <div>
              <h2>
                Common Minecraft<br />server failures
              </h2>
            </div><p>
              Our first planned playbooks cover five failures hosts can trace
              through logs and configuration files.
            </p>
          </div><div class="incident-list">
            {
              incidents.map(([icon, title, body]) => (
                <article>
                  <span class="incident-glyph">
                    <IncidentIcon name={icon} />
                  </span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
      <section id="environment" class="environment-screen" data-screen>
        <div class="environment wrap">
          <div class="environment-image">
            <img
              src="/assets/img/optimized/city.webp"
              alt="A Minecraft city built on the QubeMC network"
              width="1200"
              height="675"
              loading="lazy"
            /><span>A city on the QubeMC network</span>
          </div><div class="environment-copy">
            <h2>Paper on Pterodactyl</h2><p>
              We host Minecraft communities at QubeMC. This is the first setup
              we’re building Autopilot to support.
            </p><p>
              The agent would run outside the game, so it could read startup
              logs even if Paper fails to boot. An optional Paper probe would
              add in-game telemetry.
            </p>
          </div>
        </div>
      </section>
      <section id="contact" data-screen>
        <div class="contact wrap">
          <div class="contact-panel">
            <video
              class="contact-sand"
              aria-hidden="true"
              muted
              playsinline
              preload="none"
              data-poster="/assets/media/autopilot-sand.webp"
              data-src="/assets/media/autopilot-sand.mp4"></video>
            <h2>Which server issue<br />keeps coming back?</h2>
            <p>
              Tell us about a recent incident and what you’d need to see before
              approving an automated fix.
            </p>
            <a
              class="button primary"
              href="https://www.qubemc.com/contact-us.html">Contact QubeMC</a
            >
          </div>
        </div>
        <footer class="wrap">
          <a class="brand" href="#"
            ><img
              src="/assets/img/optimized/logo-mark-128.webp"
              width="28"
              height="28"
              alt=""
            />QubeMC Autopilot</a
          >
        </footer>
      </section>
    </main>
    <script>
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const easeOut = "cubic-bezier(.22, 1, .36, 1)";
      const canAnimate = (element: Element) => {
        const bounds = element.getBoundingClientRect();
        return (
          typeof element.animate === "function" &&
          !reducedMotion.matches &&
          !document.hidden &&
          bounds.top < innerHeight &&
          bounds.bottom > 0
        );
      };

      import {
        loadDotFont,
        mountDotScatter,
      } from "@/scripts/autopilot/hero-dots";
      import { setupPageMotion } from "@/scripts/autopilot/page-motion";

      const heroStage = document.querySelector(".hero-stage");
      if (heroStage) {
        void loadDotFont().then(() => {
          const mount = () => mountDotScatter(heroStage);
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(mount, { timeout: 1200 });
          } else {
            setTimeout(mount, 150);
          }
        });
      }
      setupPageMotion(reducedMotion);

      const sand = document.querySelector<HTMLVideoElement>(".contact-sand");
      if (sand && "IntersectionObserver" in window) {
        new IntersectionObserver(
          ([entry], observer) => {
            if (!entry.isIntersecting) return;
            sand.poster = sand.dataset.poster!;
            observer.disconnect();
          },
          { rootMargin: "240px 0px" },
        ).observe(sand);

        let inView = false;
        const syncSand = () => {
          if (reducedMotion.matches || document.hidden || !inView) {
            sand.pause();
            return;
          }
          if (sand.ended) return;
          if (!sand.hasAttribute("src")) sand.src = sand.dataset.src!;
          void sand.play().catch(() => {});
        };
        new IntersectionObserver(
          ([entry]) => {
            inView = entry.isIntersecting;
            syncSand();
          },
          { threshold: 0.05 },
        ).observe(sand);
        reducedMotion.addEventListener("change", syncSand);
        document.addEventListener("visibilitychange", syncSand);
      }

      const menu = document.querySelector<HTMLButtonElement>(".menu-button");
      const mobileNav = document.querySelector<HTMLElement>("#mobile-nav");
      const closeMenu = () => {
        if (menu && mobileNav) {
          menu.setAttribute("aria-expanded", "false");
          mobileNav.hidden = true;
        }
      };
      menu?.addEventListener("click", () => {
        const open = menu.getAttribute("aria-expanded") === "true";
        menu.setAttribute("aria-expanded", String(!open));
        if (mobileNav) mobileNav.hidden = open;
      });
      mobileNav
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          menu?.getAttribute("aria-expanded") === "true"
        ) {
          closeMenu();
          menu.focus();
        }
      });
      const media = window.matchMedia("(min-width: 761px)");
      media.addEventListener("change", () => {
        if (media.matches) closeMenu();
      });
      const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-step]"),
      );
      const workflowPanel = document.getElementById("workflow-panel");
      const track = workflowPanel?.querySelector(".workflow-signal");
      const packet = track?.querySelector(".signal-travel");
      const nodes = track?.querySelectorAll(".signal-node");
      let activeStep = 0;
      let travel: Animation | undefined;
      let arrival: Animation | undefined;

      const markArrival = (index: number, animate: boolean) => {
        nodes?.forEach((node, i) =>
          node.toggleAttribute("data-current", i === index),
        );
        const node = nodes?.[index];
        if (node && animate) {
          arrival = node.animate(
            [{ transform: "scale(.72)" }, { transform: "scale(1)" }],
            { duration: 180, easing: easeOut },
          );
        }
      };

      const settleSignal = () => {
        travel?.cancel();
        arrival?.cancel();
        travel = undefined;
        arrival = undefined;
        markArrival(activeStep, false);
      };

      const moveSignal = (previous: number) => {
        if (!track || !packet || !canAnimate(track)) {
          settleSignal();
          return;
        }

        // Continue from the current position if someone switches steps mid-flight.
        const bounds = track.getBoundingClientRect();
        const from = travel
          ? ((packet.getBoundingClientRect().left - bounds.left) /
              bounds.width) *
            100
          : previous * 25;
        const destination = activeStep;
        travel?.cancel();
        arrival?.cancel();
        nodes?.forEach((node) => node.removeAttribute("data-current"));
        const animation = packet.animate(
          [
            { opacity: 1, transform: `translateX(${from}%)` },
            { opacity: 1, transform: `translateX(${destination * 25}%)` },
          ],
          { duration: 430, easing: easeOut },
        );
        travel = animation;
        animation.onfinish = () => {
          if (travel !== animation) return;
          travel = undefined;
          markArrival(destination, true);
        };
      };

      const settleMotion = () => {
        if (reducedMotion.matches || document.hidden) {
          slideAnimations.forEach((animation) => animation.cancel());
          outgoingCard?.removeAttribute("data-outgoing");
          scheduleRotation();
          settleSignal();
        }
      };
      reducedMotion.addEventListener("change", () => {
        settleMotion();
        scheduleRotation();
      });
      document.addEventListener("visibilitychange", () => {
        settleMotion();
        scheduleRotation();
      });
      if (track && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) settleSignal();
        });
        observer.observe(track);
      }

      const cards = Array.from(
        document.querySelectorAll<HTMLElement>(".workflow-card"),
      );
      const workflow = document.querySelector<HTMLElement>(".workflow-layout");
      const rotation =
        document.querySelector<HTMLButtonElement>(".rotation-control");
      let slideAnimations: Animation[] = [];
      let outgoingCard: HTMLElement | undefined;
      let timer: number | undefined;
      let visibleWorkflow = false;
      let manuallyPaused = false;
      let hovered = false;

      function scheduleRotation() {
        window.clearTimeout(timer);
        if (!rotation || !workflow) return;
        rotation.hidden = reducedMotion.matches;
        if (
          !visibleWorkflow ||
          manuallyPaused ||
          hovered ||
          document.hidden ||
          reducedMotion.matches ||
          workflow.contains(document.activeElement)
        )
          return;
        timer = window.setTimeout(
          () => select((activeStep + 1) % cards.length),
          6000,
        );
      }

      const select = (index: number) => {
        if (activeStep === index) return;
        const previous = activeStep;
        activeStep = index;
        tabs.forEach((tab, i) => {
          tab.setAttribute("aria-selected", String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
        });
        workflowPanel?.setAttribute("aria-labelledby", `step-${index}`);
        const leaving = cards[previous];
        const entering = cards[index];
        slideAnimations.forEach((animation) => animation.cancel());
        outgoingCard?.removeAttribute("data-outgoing");
        leaving.removeAttribute("data-active");
        leaving.setAttribute("aria-hidden", "true");
        entering.setAttribute("data-active", "");
        entering.setAttribute("aria-hidden", "false");
        if (canAnimate(entering)) {
          const direction =
            (previous + 1) % cards.length === index || index > previous
              ? 1
              : -1;
          leaving.setAttribute("data-outgoing", "");
          outgoingCard = leaving;
          const transition = { duration: 440, easing: easeOut };
          const exit = leaving.animate(
            [
              { transform: "none" },
              { transform: `translateX(${-direction * 104}%)` },
            ],
            transition,
          );
          slideAnimations = [
            exit,
            entering.animate(
              [
                { transform: `translateX(${direction * 104}%)` },
                { transform: "none" },
              ],
              transition,
            ),
          ];
          exit.onfinish = () => leaving.removeAttribute("data-outgoing");
        }
        scheduleRotation();
        moveSignal(previous);
      };
      if (workflow && rotation && "IntersectionObserver" in window) {
        new IntersectionObserver(
          ([entry]) => {
            visibleWorkflow = entry.intersectionRatio >= 0.45;
            if (!visibleWorkflow) {
              slideAnimations.forEach((animation) => animation.cancel());
              outgoingCard?.removeAttribute("data-outgoing");
            }
            scheduleRotation();
          },
          { threshold: 0.45 },
        ).observe(workflow);
        const updateHover = (event: PointerEvent) => {
          if (event.pointerType === "touch") return;
          hovered = event.type === "pointerenter";
          scheduleRotation();
        };
        workflow.addEventListener("pointerenter", updateHover);
        workflow.addEventListener("pointerleave", updateHover);
        workflow.addEventListener("focusin", scheduleRotation);
        workflow.addEventListener("focusout", () =>
          queueMicrotask(scheduleRotation),
        );
        rotation.addEventListener("click", () => {
          manuallyPaused = !manuallyPaused;
          rotation.textContent = manuallyPaused
            ? "Resume autoplay"
            : "Pause autoplay";
          scheduleRotation();
        });
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(i));
        tab.addEventListener("keydown", (e) => {
          let next = i;
          if (e.key === "ArrowDown" || e.key === "ArrowRight")
            next = (i + 1) % tabs.length;
          else if (e.key === "ArrowUp" || e.key === "ArrowLeft")
            next = (i + tabs.length - 1) % tabs.length;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = tabs.length - 1;
          else return;
          e.preventDefault();
          select(next);
          tabs[next].focus();
        });
      });
    </script>
    <style is:global>
      /* Independent exploration styles. Original homepage and theme tokens remain untouched. */
      :root {
        --logo-green: #189040;
        --logo-green-ink: #080f09;
        --ui-ease: cubic-bezier(0.22, 1, 0.36, 1);
        color-scheme: dark;
        background: #090b0f;
        color: #f0f2ed;
        font-family: var(--autopilot-font);
        scroll-behavior: smooth;
        scroll-padding-top: 32px;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        font: inherit;
      }
      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }
      a:focus-visible,
      button:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid var(--logo-green);
        outline-offset: 5px;
      }
      img {
        max-width: 100%;
        display: block;
      }
      h1,
      h2,
      h3,
      p {
        margin: 0;
      }
      h1,
      h2,
      h3 {
        font-weight: 500;
      }
      h2 {
        font-size: clamp(32px, 3.4vw, 48px);
        line-height: 1.16;
        letter-spacing: -0.035em;
      }
      h3 {
        font-size: 20px;
        line-height: 1.4;
      }
      p {
        color: #aeb8b1;
      }
      .wrap {
        width: min(1280px, calc(100% - 96px));
        margin-inline: auto;
      }
      .header {
        height: 104px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #2b333d;
        position: relative;
        z-index: 5;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -0.04em;
      }
      .brand-product {
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 0;
        color: #9ca69e;
        margin-left: 8px;
      }
      .desktop-nav {
        display: flex;
        gap: 32px;
        color: #bbc3bd;
        font-size: 13px;
      }
      .desktop-nav a:hover,
      footer a:hover {
        color: #94d6a0;
      }
      .button {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        border: 1px solid #3a443d;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        transition:
